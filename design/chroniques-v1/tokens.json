{
  "name": "Chroniques d’Azeroth",
  "version": 1,
  "status": "design-proposal-not-runtime",
  "palette": {
    "background": "#10171B",
    "panel": "#182126",
    "inset": "#11191E",
    "bronze": "#897044",
    "gold": "#D8B56C",
    "ivory": "#F0E7D4",
    "text": "#D5D7D4",
    "muted": "#A4AFAF",
    "victory": "#9CC492",
    "danger": "#E38D89",
    "favorite": "#CF636F",
    "classAccent": "native-class-color-used-sparingly"
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32
  ],
  "typography": {
    "title": {
      "family": "local-serif",
      "size": 28
    },
    "section": {
      "family": "local-serif",
      "size": 21
    },
    "number": {
      "family": "local-sans",
      "size": 28
    },
    "body": {
      "family": "local-sans",
      "size": 14
    },
    "meta": {
      "family": "local-sans",
      "size": 11
    }
  },
  "components": {
    "panelRadius": 2,
    "navHeight": 44,
    "rowHeight": 56,
    "icon": 20,
    "bodyMargin": 24,
    "bar": {
      "runTimerDefault": false,
      "opacityDefault": 1,
      "widthRange": [
        240,
        1600
      ],
      "heightRange": [
        28,
        96
      ],
      "scopes": [
        "run",
        "current-class",
        "fixed-class",
        "all-classes"
      ],
      "overflow": "explicit-or-wrap-never-tiny-text"
    }
  }
}
